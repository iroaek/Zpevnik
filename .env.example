# Veřejná kanonická HTTPS adresa včetně případného podadresáře a koncového lomítka.
VITE_PUBLIC_BASE_URL=https://iroaek.github.io/Zpevnik/

# Stávající backend používá Neon Auth a Neon Data API. Zkopírujte celé veřejné adresy.
# DATABASE_URL, heslo ani Neon API key nikdy nepatří do VITE_* proměnných.
VITE_NEON_AUTH_URL=https://YOUR_NEON_AUTH_ENDPOINT
VITE_NEON_DATA_API_URL=https://YOUR_NEON_DATA_API_ENDPOINT
VITE_REQUIRE_SECURE_ACCESS=true

# Stávající omezená politika: 1–30 dní od podepsaného iat, nezávisle na exp
# online JWT. Veřejný JWKS se načítá jen z Auth URL a ukládá pro offline ověření.
VITE_NEON_OFFLINE_DAYS=30
