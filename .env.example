# Veřejná kanonická HTTPS adresa včetně případného podadresáře a koncového lomítka.
VITE_PUBLIC_BASE_URL=https://iroaek.github.io/Zpevnik/

# Přechod databázových operací na Neon. Data API URL je veřejný HTTPS endpoint;
# DATABASE_URL, heslo ani Neon API key nikdy nepatří do VITE_* proměnných.
VITE_DATA_BACKEND=supabase
VITE_NEON_DATA_API_URL=https://YOUR_DATA_API_HOST/rest/v1
VITE_NEON_OFFLINE_GRANT_URL=https://PROJECT_REF.supabase.co/functions/v1/offline-grant

# V první migrační fázi zajišťuje Supabase pouze Auth a soukromé Storage.
# Použijte jen veřejný publishable key, nikdy service_role.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_REQUIRE_SECURE_ACCESS=false

# Veřejná část podepsaného offline oprávnění. JWKS obsahuje pouze EC veřejné
# klíče; privátní JWK patří výhradně do serverové funkce.
VITE_OFFLINE_GRANT_ISSUER=https://PROJECT_REF.supabase.co/functions/v1/offline-grant
VITE_OFFLINE_GRANT_AUDIENCE=cesky-zpevnik-offline
VITE_OFFLINE_GRANT_PUBLIC_JWKS={"keys":[{"kty":"EC","crv":"P-256","kid":"REPLACE_ME","x":"REPLACE_ME","y":"REPLACE_ME","alg":"ES256","use":"sig"}]}
